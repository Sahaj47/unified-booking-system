# .env.example — copy to .env for local development.
# Never commit .env.

# PostgreSQL connection string.
# Local example (Docker or local Postgres):
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/unified_booking

# For Render: this is set automatically — do not set it manually there.

SECRET_KEY=change-this-to-a-long-random-string-in-production

# Optional — leave blank to use the rule-based fallback summary
ANTHROPIC_API_KEY=